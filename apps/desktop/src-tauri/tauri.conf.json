{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pantheon",
  "version": "0.1.0",
  "identifier": "studio.holley.thesmos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pantheon — Holley Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 800,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "targets": ["nsis", "dmg", "app"],
    "resources": ["resources/*"],
    "shortDescription": "Holley Studio business workspace",
    "longDescription": "Pantheon by Holley Studio. Accountable AI co-workers, repeatable client workflows, evidence-backed deliverables, and human approval. Powered by Thesmos."
  }
}
