{
  "name": "@thesmos/desktop",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sidecar.json --noEmit",
    "test": "node --import ../../node_modules/tsx/dist/loader.mjs --test tests/*.test.ts",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "npm run sidecar:build && tauri build",
    "release:publish": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@tauri-apps/api": "^2",
    "fast-xml-parser": "5.11.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
