# Shell scripts must use LF so shebangs and POSIX sh work after checkout on Windows.
*.sh text eol=lf

# Windows cmd wrappers keep CRLF for cmd.exe compatibility.
*.cmd text eol=crlf

# Catalog and agent definitions are parsed as structured markdown (frontmatter
# delimiters, fenced blocks). Git for Windows defaults to core.autocrlf=true,
# which would check these out as CRLF and break that parsing. Pin them to LF.
*.md text eol=lf
